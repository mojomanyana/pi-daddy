{
  "name": "pi-daddy-workspace",
  "private": true,
  "description": "Workspace root for pi-daddy. Never published; the shipped package is `pi-daddy` under packages/pi-daddy. Named -workspace only because npm workspaces require the root and its members to have distinct names.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check . || (echo ===PRETTIER-DIFF=== && prettier packages/pi-daddy/test/dashboard-projection.test.ts | diff packages/pi-daddy/test/dashboard-projection.test.ts - ; echo ===END=== ; exit 1)"
  },
  "devDependencies": {
    "prettier": "3.9.8"
  }
}
