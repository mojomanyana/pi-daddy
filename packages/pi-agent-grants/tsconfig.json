{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src",
    // The source imports with explicit `.ts` extensions, which is what lets `node --test src/**` and
    // pi's own loader read it directly. This rewrites them to `.js` on the way out so the EMITTED
    // package is valid ESM for an ordinary Node consumer. Requires TypeScript >= 5.7.
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts"]
}
