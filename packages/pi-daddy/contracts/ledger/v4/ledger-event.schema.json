{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mojomanyana/pi-daddy/contracts/ledger/v4/ledger-event.schema.json",
  "title": "pi-daddy candidate ledgerVersion 4 work event",
  "description": "One closed work-v4 event, not a grant or authority receipt. Strict text ingestion additionally verifies duplicate members, exact numeric tokens, canonical sets, digests and byte/depth limits. Projection separately resolves graphs and explicit host authority; schema conformance never proves acceptance.",
  "oneOf": [
    { "$ref": "#/$defs/workRevisionEvent" },
    { "$ref": "#/$defs/workSnapshotEvent" },
    { "$ref": "#/$defs/workOccurrenceEvent" },
    { "$ref": "#/$defs/workAcceptanceEvent" }
  ],
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+\\-]{0,127}$" },
    "digest": { "type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}$" },
    "revisionNumber": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "timestamp": {
      "type": "string", "format": "date-time", "minLength": 24, "maxLength": 24,
      "pattern": "^(?!0000)[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$",
      "$comment": "The runtime always verifies the calendar date, independently of a schema validator's format support."
    },
    "executionId": {
      "type": "string", "minLength": 41, "maxLength": 41,
      "pattern": "^[eE][xX][eE][cC]:[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "revisionKind": { "enum": ["scope", "goal", "node", "obligation", "artifact", "policy"] },
    "occurrenceProvenance": { "enum": ["declared", "observed"] },
    "occurrenceState": { "enum": ["unknown", "starting", "running", "completed", "failed"] },
    "identity": {
      "type": "object", "additionalProperties": false, "required": ["id", "digest"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "digest": { "$ref": "#/$defs/digest" } }
    },
    "eventRef": {
      "type": "object", "additionalProperties": false, "required": ["eventId", "digest"],
      "properties": { "eventId": { "$ref": "#/$defs/id" }, "digest": { "$ref": "#/$defs/digest" } }
    },
    "revisionRef": {
      "type": "object", "additionalProperties": false, "required": ["kind", "id", "revision", "digest"],
      "properties": {
        "kind": { "$ref": "#/$defs/revisionKind" }, "id": { "$ref": "#/$defs/id" },
        "revision": { "$ref": "#/$defs/revisionNumber" }, "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "scopeRef": { "allOf": [{ "$ref": "#/$defs/revisionRef" }, { "type": "object", "properties": { "kind": { "const": "scope" } } }] },
    "intentRef": { "allOf": [{ "$ref": "#/$defs/revisionRef" }, { "type": "object", "properties": { "kind": { "enum": ["goal", "node"] } } }] },
    "goalParentRef": { "allOf": [{ "$ref": "#/$defs/revisionRef" }, { "type": "object", "properties": { "kind": { "enum": ["scope", "goal"] } } }] },
    "obligationRef": { "allOf": [{ "$ref": "#/$defs/revisionRef" }, { "type": "object", "properties": { "kind": { "const": "obligation" } } }] },
    "artifactRef": { "allOf": [{ "$ref": "#/$defs/revisionRef" }, { "type": "object", "properties": { "kind": { "const": "artifact" } } }] },
    "policyRef": { "allOf": [{ "$ref": "#/$defs/revisionRef" }, { "type": "object", "properties": { "kind": { "const": "policy" } } }] },
    "inventoryRef": { "allOf": [{ "$ref": "#/$defs/revisionRef" }, { "type": "object", "properties": { "kind": { "enum": ["goal", "node", "obligation", "artifact", "policy"] } } }] },
    "workRevision": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "id", "revision", "scopeId", "predecessor", "contentDigest", "parent", "dependencies", "ownerId", "permittedEffects", "policy", "digest"],
      "properties": {
        "kind": { "$ref": "#/$defs/revisionKind" }, "id": { "$ref": "#/$defs/id" }, "revision": { "$ref": "#/$defs/revisionNumber" },
        "scopeId": { "$ref": "#/$defs/id" }, "predecessor": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/revisionRef" }] },
        "contentDigest": { "$ref": "#/$defs/digest" }, "parent": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/revisionRef" }] },
        "dependencies": { "type": "array", "maxItems": 256, "uniqueItems": true, "items": { "$ref": "#/$defs/obligationRef" } },
        "ownerId": { "$ref": "#/$defs/id" },
        "permittedEffects": { "type": "array", "maxItems": 256, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "policy": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/policyRef" }] }, "digest": { "$ref": "#/$defs/digest" }
      },
      "allOf": [
        {
          "if": { "type": "object", "properties": { "revision": { "const": 1 } } },
          "then": { "type": "object", "properties": { "predecessor": { "type": "null" } } },
          "else": { "type": "object", "properties": { "predecessor": { "$ref": "#/$defs/revisionRef" } } }
        },
        { "oneOf": [
          { "type": "object", "properties": { "kind": { "const": "scope" }, "parent": { "type": "null" }, "dependencies": { "type": "array", "maxItems": 0 }, "policy": { "type": "null" } } },
          { "type": "object", "properties": { "kind": { "const": "goal" }, "parent": { "$ref": "#/$defs/goalParentRef" }, "dependencies": { "type": "array", "maxItems": 0 }, "policy": { "type": "null" } } },
          { "type": "object", "properties": { "kind": { "const": "node" }, "parent": { "$ref": "#/$defs/intentRef" }, "dependencies": { "type": "array", "maxItems": 0 }, "policy": { "type": "null" } } },
          { "type": "object", "properties": { "kind": { "const": "obligation" }, "parent": { "$ref": "#/$defs/intentRef" }, "policy": { "$ref": "#/$defs/policyRef" } } },
          { "type": "object", "properties": { "kind": { "enum": ["artifact", "policy"] }, "parent": { "type": "null" }, "dependencies": { "type": "array", "maxItems": 0 }, "permittedEffects": { "type": "array", "maxItems": 0 }, "policy": { "type": "null" } } }
        ] }
      ],
      "$comment": "Runtime also requires scopeId=id for scope, same kind/id and exact predecessor revision+1, canonical list ordering, and own digest equality. Graph scope/history checks require the complete event snapshot."
    },
    "obligationBinding": {
      "type": "object", "additionalProperties": false, "required": ["intent", "obligation", "artifact", "policy"],
      "properties": {
        "intent": { "$ref": "#/$defs/intentRef" }, "obligation": { "$ref": "#/$defs/obligationRef" },
        "artifact": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/artifactRef" }] }, "policy": { "$ref": "#/$defs/policyRef" }
      }
    },
    "workSnapshot": {
      "type": "object", "additionalProperties": false, "required": ["snapshotId", "scope", "revisions", "bindings", "digest"],
      "properties": {
        "snapshotId": { "$ref": "#/$defs/id" }, "scope": { "$ref": "#/$defs/scopeRef" },
        "revisions": { "type": "array", "maxItems": 256, "uniqueItems": true, "items": { "$ref": "#/$defs/inventoryRef" } },
        "bindings": { "type": "array", "maxItems": 256, "uniqueItems": true, "items": { "$ref": "#/$defs/obligationBinding" } },
        "digest": { "$ref": "#/$defs/digest" }
      },
      "$comment": "Runtime orders bindings by obligation ref, rejects duplicate obligation keys, and checks digests. Projection validates unique selected entities, exact bindings, same-scope ancestors, predecessors and dependencies."
    },
    "occurrenceLabels": {
      "type": "object", "additionalProperties": false,
      "required": ["sessionId", "branchLeafId", "toolCallId", "taskId", "workspaceId", "definitionDigest", "configurationDigest", "modelId", "effortId"],
      "properties": {
        "sessionId": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/id" }] },
        "branchLeafId": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/id" }] },
        "toolCallId": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/id" }] },
        "taskId": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/id" }] },
        "workspaceId": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/id" }] },
        "definitionDigest": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/digest" }] },
        "configurationDigest": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/digest" }] },
        "modelId": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/id" }] },
        "effortId": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/id" }] }
      }
    },
    "occurrencePayload": {
      "type": "object", "additionalProperties": false,
      "required": ["scope", "obligation", "executionId", "parentExecutionId", "childId", "variantId", "artifact", "provenance", "state", "labels"],
      "properties": {
        "scope": { "$ref": "#/$defs/scopeRef" }, "obligation": { "$ref": "#/$defs/obligationRef" }, "executionId": { "$ref": "#/$defs/executionId" },
        "parentExecutionId": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/executionId" }] },
        "childId": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/id" }] }, "variantId": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/id" }] },
        "artifact": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/artifactRef" }] },
        "provenance": { "$ref": "#/$defs/occurrenceProvenance" }, "state": { "$ref": "#/$defs/occurrenceState" }, "labels": { "$ref": "#/$defs/occurrenceLabels" }
      },
      "$comment": "Runtime rejects self-parent execution identity. Provenance is wire evidence, never acceptance authority."
    },
    "evidenceRef": {
      "type": "object", "additionalProperties": false, "required": ["id", "digest", "event"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "digest": { "$ref": "#/$defs/digest" }, "event": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/eventRef" }] } }
    },
    "acceptanceBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["snapshot", "scope", "intent", "obligation", "artifact", "artifactDigest", "policy", "evidence"],
      "properties": {
        "snapshot": { "$ref": "#/$defs/identity" }, "scope": { "$ref": "#/$defs/scopeRef" }, "intent": { "$ref": "#/$defs/intentRef" },
        "obligation": { "$ref": "#/$defs/obligationRef" }, "artifact": { "$ref": "#/$defs/artifactRef" }, "artifactDigest": { "$ref": "#/$defs/digest" },
        "policy": { "$ref": "#/$defs/policyRef" }, "evidence": { "type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": { "$ref": "#/$defs/evidenceRef" } }
      }
    },
    "acceptancePayload": {
      "type": "object", "additionalProperties": false, "required": ["authorityId", "binding"],
      "properties": { "authorityId": { "$ref": "#/$defs/id" }, "binding": { "$ref": "#/$defs/acceptanceBinding" } }
    },
    "revisionPayload": {
      "type": "object", "additionalProperties": false, "required": ["revision"], "properties": { "revision": { "$ref": "#/$defs/workRevision" } }
    },
    "snapshotPayload": {
      "type": "object", "additionalProperties": false, "required": ["snapshot"], "properties": { "snapshot": { "$ref": "#/$defs/workSnapshot" } }
    },
    "workRevisionEvent": {
      "type": "object", "additionalProperties": false, "required": ["ledgerVersion", "event", "eventId", "ts", "payload", "digest"],
      "properties": { "ledgerVersion": { "const": 4 }, "event": { "const": "work_revision" }, "eventId": { "$ref": "#/$defs/id" }, "ts": { "$ref": "#/$defs/timestamp" }, "payload": { "$ref": "#/$defs/revisionPayload" }, "digest": { "$ref": "#/$defs/digest" } }
    },
    "workSnapshotEvent": {
      "type": "object", "additionalProperties": false, "required": ["ledgerVersion", "event", "eventId", "ts", "payload", "digest"],
      "properties": { "ledgerVersion": { "const": 4 }, "event": { "const": "work_snapshot" }, "eventId": { "$ref": "#/$defs/id" }, "ts": { "$ref": "#/$defs/timestamp" }, "payload": { "$ref": "#/$defs/snapshotPayload" }, "digest": { "$ref": "#/$defs/digest" } }
    },
    "workOccurrenceEvent": {
      "type": "object", "additionalProperties": false, "required": ["ledgerVersion", "event", "eventId", "ts", "payload", "digest"],
      "properties": { "ledgerVersion": { "const": 4 }, "event": { "const": "work_occurrence" }, "eventId": { "$ref": "#/$defs/id" }, "ts": { "$ref": "#/$defs/timestamp" }, "payload": { "$ref": "#/$defs/occurrencePayload" }, "digest": { "$ref": "#/$defs/digest" } }
    },
    "workAcceptanceEvent": {
      "type": "object", "additionalProperties": false, "required": ["ledgerVersion", "event", "eventId", "ts", "payload", "digest"],
      "properties": { "ledgerVersion": { "const": 4 }, "event": { "const": "work_acceptance" }, "eventId": { "$ref": "#/$defs/id" }, "ts": { "$ref": "#/$defs/timestamp" }, "payload": { "$ref": "#/$defs/acceptancePayload" }, "digest": { "$ref": "#/$defs/digest" } }
    }
  }
}
