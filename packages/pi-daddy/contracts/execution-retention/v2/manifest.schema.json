  "required": [
    "version",
    "archiveId",
    "identity",
    "native",
    "nativeSession",
    "state",
    "outcome",
    "content",
    "coverage",
    "acceptance"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "running"
          }
        }
      },
      "then": {
        "properties": {
          "outcome": {
            "const": null
          }
        }
      },
      "else": {
        "properties": {
          "outcome": {
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "nativeSession": {
            "properties": {
              "branchState": {
                "const": "unknown"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "nativeSession": {
            "properties": {
              "branchLeafId": {
                "const": null
              }
            }
          },
          "native": {
            "properties": {
              "branchLeafId": {
                "const": null
              }
            }
          }
        }
      }
    }
  ]
}
