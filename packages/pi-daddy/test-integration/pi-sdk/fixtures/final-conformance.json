    {
      "id": "text-blocks-concatenate",
      "input": {
        "records": [
          {
            "type": "session",
            "version": 3,
            "id": "conformance-session",
            "cwd": "FIXTURE_CWD"
          },
          {
            "type": "agent_start"
          },
          {
            "type": "turn_start"
          },
          {
            "type": "message_end",
            "message": {
              "role": "user",
              "content": [
                {
                  "type": "text",
                  "text": "question"
                }
              ],
              "timestamp": 0
            }
          },
          {
            "type": "message_end",
            "message": {
              "role": "assistant",
              "content": [
                {
                  "type": "text",
                  "text": "  first"
                },
                {
                  "type": "thinking",
                  "thinking": "private"
                },
                {
                  "type": "text",
                  "text": "second\n\n"
                }
              ],
              "stopReason": "stop",
              "timestamp": 1
            }
          },
          {
            "type": "agent_settled"
          }
        ]
      },
      "expected": {
        "available": true,
        "finalText": "  firstsecond\n\n",
        "status": "complete"
      }
    },
