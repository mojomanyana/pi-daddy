{
  "version": 1,
  "piVersion": "1.0.4",
  "scope": "Shared terminal-output eligibility and exact visible-text assembly. Captured input provenance remains in provenance.json; synthetic records are tests, not new CLI captures. Harness redaction and runtime persisted-session identity checks are separate consumer requirements. Unavailable finalText is diagnostic evidence only. Whitespace-only text remains nonempty bytes.",
  "cases": [
    {
      "id": "captured-success",
      "input": {
        "fixture": "success.jsonl"
      },
      "expected": {
        "available": true,
        "finalText": "  final first\nfinal second final third   ",
        "status": "complete"
      }
    },
    {
      "id": "captured-nested",
      "input": {
        "fixture": "nested.jsonl"
      },
