{
  "name": "pi-daddy",
  "version": "0.19.0",
  "description": "Capability governance for pi sub-agents: spawn Agent Skills (SKILL.md) definitions whose allowed-tools becomes a grant that can only narrow going down a delegation tree, enforced by pi's own --tools allowlist, with an append-only ledger.",
  "keywords": [
    "pi-package",
    "subagents",
    "capabilities",
    "least-privilege",
    "governance",
    "audit"
  ],
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mojomanyana/pi-daddy.git",
    "directory": "packages/pi-daddy"
  },
  "homepage": "https://github.com/mojomanyana/pi-daddy#readme",
  "bugs": {
    "url": "https://github.com/mojomanyana/pi-daddy/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./resolve": {
      "types": "./dist/resolve.d.ts",
      "default": "./dist/resolve.js"
    },
    "./ledger": {
      "types": "./dist/ledger.d.ts",
      "default": "./dist/ledger.js"
    },
    "./spawn": {
      "types": "./dist/spawn.d.ts",
      "default": "./dist/spawn.js"
    },
    "./delegate": {
      "types": "./dist/delegate.d.ts",
      "default": "./dist/delegate.js"
    },
    "./catalog": {
      "types": "./dist/catalog.d.ts",
      "default": "./dist/catalog.js"
    },
    "./propagation": {
      "types": "./dist/propagation.d.ts",
      "default": "./dist/propagation.js"
    },
    "./definitions": {
      "types": "./dist/definitions.d.ts",
      "default": "./dist/definitions.js"
    },
    "./fanout": {
      "types": "./dist/fanout.d.ts",
      "default": "./dist/fanout.js"
    },
    "./pi-tools": {
      "types": "./dist/pi-tools.d.ts",
      "default": "./dist/pi-tools.js"
    },
    "./run-herdr": {
      "types": "./dist/run-herdr.d.ts",
      "default": "./dist/run-herdr.js"
    },
    "./herdr-poll": {
      "types": "./dist/herdr-poll.d.ts",
      "default": "./dist/herdr-poll.js"
    },
    "./herdr-cli": {
      "types": "./dist/herdr-cli.d.ts",
      "default": "./dist/herdr-cli.js"
    },
    "./executor": {
      "types": "./dist/executor.d.ts",
      "default": "./dist/executor.js"
    },
    "./progress": {
      "types": "./dist/progress.d.ts",
      "default": "./dist/progress.js"
    },
    "./chain": {
      "types": "./dist/chain.d.ts",
      "default": "./dist/chain.js"
    },
    "./run-child": {
      "types": "./dist/run-child.d.ts",
      "default": "./dist/run-child.js"
    },
    "./approval": {
      "types": "./dist/approval.d.ts",
      "default": "./dist/approval.js"
    },
    "./approval-store": {
      "types": "./dist/approval-store.d.ts",
      "default": "./dist/approval-store.js"
    },
    "./approval-prompt": {
      "types": "./dist/approval-prompt.d.ts",
      "default": "./dist/approval-prompt.js"
    },
    "./init": {
      "types": "./dist/init.d.ts",
      "default": "./dist/init.js"
    },
    "./skill-packages": {
      "types": "./dist/skill-packages.d.ts",
      "default": "./dist/skill-packages.js"
    },
    "./correlation": {
      "types": "./dist/correlation.d.ts",
      "default": "./dist/correlation.js"
    },
    "./refusals": {
      "types": "./dist/refusals.d.ts",
      "default": "./dist/refusals.js"
    },
    "./workspace": {
      "types": "./dist/workspace.d.ts",
      "default": "./dist/workspace.js"
    },
    "./check-runner": {
      "types": "./dist/check-runner.d.ts",
      "default": "./dist/check-runner.js"
    },
    "./contracts/ledger/v2/ledger-event.schema.json": "./contracts/ledger/v2/ledger-event.schema.json",
    "./contracts/ledger/v2/fixtures/*.json": "./contracts/ledger/v2/fixtures/*.json"
  },
  "bin": {
    "pi-daddy": "./dist/cli.js"
  },
  "files": [
    "dist",
    "extensions",
    "src",
    "contracts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "node --test test/*.test.ts",
    "test:integration": "node --test test-integration/*.it.ts",
    "contracts:generate": "node scripts/generate-ledger-v2-contract.ts",
    "prepack": "npm run build",
    "test:smoke": "node scripts/smoke-installed.mjs"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "pi": {
    "extensions": [
      "./extensions/grants.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.83.0",
    "typebox": ">=1.0.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.83.0",
    "@types/node": "^22.0.0",
    "typebox": ">=1.0.0",
    "typescript": "^5.7.0"
  }
}
