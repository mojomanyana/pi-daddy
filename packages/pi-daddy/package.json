  },
  "files": [
    "dist",
    "extensions",
    "src",
    "contracts",
    "herdr-plugin",
    "THIRD_PARTY_LICENSES",
    "THIRD_PARTY_NOTICES.md",
    "README.md",
    "PRODUCT-GUIDE.md",
    "REQUIREMENTS.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "node scripts/unit-tests.ts",
    "test:dashboard-pty": "if [ \"$(uname -s)\" = Linux ]; then python3 test/dashboard-cli-pty.py; else echo 'dashboard PTY probe requires Unix pty/Unix sockets'; fi",
    "test:integration": "node --test test-integration/*.it.ts",
    "test:integration:ci": "node --test test-integration/approval.it.ts test-integration/governance.it.ts test-integration/activity.it.ts",
    "contracts:generate": "node scripts/generate-ledger-v3-contract.ts",
    "contracts:generate:v4": "node scripts/generate-ledger-v4-contract.ts contracts/ledger/v4",
    "prepack": "npm run build",
    "test:smoke": "node scripts/smoke-installed.mjs"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "pi": {
    "extensions": [
      "./extensions/grants.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.83.0",
    "@types/node": ">=22",
    "typebox": ">=1.0.0"
  },
